generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CREDITO
  DEBITO
  PIX
  DINHEIRO
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  sku         String   @unique
  barcode     String?
  brand       String?
  category    String
  price       Float
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  ProductVariant[]
  saleItems SaleItem[]
}

model ProductVariant {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  productId         String   @db.ObjectId
  product           Product  @relation(fields: [productId], references: [id])
  size              String
  color             String
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems    SaleItem[]
  exchangesOut Exchange[] @relation("ExchangeReturnedVariant")
  exchangesIn  Exchange[] @relation("ExchangeNewVariant")
  purchaseItems PurchaseInvoiceItem[]
  lastPurchaseUnitCost Float?

  @@unique([productId, size, color])
}

model Sale {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  total         Float
  discount      Float         @default(0)
  paymentMethod PaymentMethod
  installments  Int           @default(1)
  cardBrand     String?
  status        SaleStatus    @default(COMPLETED)
  customerName  String?
  customerPhone String?
  exchangeVersion Int         @default(0)
  createdAt     DateTime      @default(now())

  items     SaleItem[]
  exchanges Exchange[]
  fiscalDocument FiscalDocument?
}

model PurchaseInvoice {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  accessKey      String?
  supplierCnpj   String
  supplierName   String
  recipientCnpj  String
  number         String
  series         String
  issuedAt       DateTime
  total          Float
  source         String
  xml            String?
  createdById    String @db.ObjectId
  createdAt      DateTime @default(now())
  items          PurchaseInvoiceItem[]

  @@unique([supplierCnpj, number, series])
}

model PurchaseInvoiceItem {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  purchaseInvoiceId String @db.ObjectId
  purchaseInvoice  PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  productVariantId String @db.ObjectId
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  itemNumber       Int
  supplierCode     String
  name             String
  ncm              String?
  quantity         Float
  stockQuantity    Int
  unitCost         Float
  subtotal         Float
}

enum FiscalDocumentStatus {
  PENDING_CONFIGURATION
}

model FiscalDocument {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  saleId      String @unique @db.ObjectId
  sale        Sale @relation(fields: [saleId], references: [id])
  model       String @default("65")
  status      FiscalDocumentStatus @default(PENDING_CONFIGURATION)
  message     String
  snapshot    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SaleItem {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  saleId           String         @db.ObjectId
  sale             Sale           @relation(fields: [saleId], references: [id])
  productId        String         @db.ObjectId
  product          Product        @relation(fields: [productId], references: [id])
  productVariantId String         @db.ObjectId
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Float
  subtotal         Float
}

model Exchange {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  saleId String @db.ObjectId
  sale   Sale   @relation(fields: [saleId], references: [id])

  returnedVariantId String         @db.ObjectId
  returnedVariant   ProductVariant @relation("ExchangeReturnedVariant", fields: [returnedVariantId], references: [id])
  returnedQuantity  Int            @default(1)

  newVariantId String?         @db.ObjectId
  newVariant   ProductVariant? @relation("ExchangeNewVariant", fields: [newVariantId], references: [id])
  newQuantity  Int?

  priceDifference Float    @default(0)
  reason          String?
  refundMethod    String?
  createdAt       DateTime @default(now())
}

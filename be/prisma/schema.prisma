generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CREDITO
  DEBITO
  PIX
  DINHEIRO
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  sku         String   @unique
  category    String
  price       Float
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  ProductVariant[]
  saleItems SaleItem[]
}

model ProductVariant {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  productId         String   @db.ObjectId
  product           Product  @relation(fields: [productId], references: [id])
  size              String
  color             String
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems    SaleItem[]
  exchangesOut Exchange[] @relation("ExchangeReturnedVariant")
  exchangesIn  Exchange[] @relation("ExchangeNewVariant")

  @@unique([productId, size, color])
}

model Sale {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  total         Float
  discount      Float         @default(0)
  paymentMethod PaymentMethod
  installments  Int           @default(1)
  cardBrand     String?
  status        SaleStatus    @default(COMPLETED)
  customerName  String?
  customerPhone String?
  createdAt     DateTime      @default(now())

  items     SaleItem[]
  exchanges Exchange[]
}

model SaleItem {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  saleId           String         @db.ObjectId
  sale             Sale           @relation(fields: [saleId], references: [id])
  productId        String         @db.ObjectId
  product          Product        @relation(fields: [productId], references: [id])
  productVariantId String         @db.ObjectId
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Float
  subtotal         Float
}

model Exchange {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  saleId String @db.ObjectId
  sale   Sale   @relation(fields: [saleId], references: [id])

  returnedVariantId String         @db.ObjectId
  returnedVariant   ProductVariant @relation("ExchangeReturnedVariant", fields: [returnedVariantId], references: [id])
  returnedQuantity  Int            @default(1)

  newVariantId String?         @db.ObjectId
  newVariant   ProductVariant? @relation("ExchangeNewVariant", fields: [newVariantId], references: [id])
  newQuantity  Int?

  priceDifference Float    @default(0)
  reason          String?
  refundMethod    String?
  createdAt       DateTime @default(now())
}
